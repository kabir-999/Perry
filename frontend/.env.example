# Copy to frontend/.env.local for local dev, or set as a Vercel project
# environment variable for deployment.
#
# Local dev: leave unset — Vite's dev-server proxy (vite.config.ts) forwards
# "/api" to http://localhost:8000 automatically.
#
# Vercel: set to your deployed Railway backend's URL, including the "/api"
# prefix, no trailing slash.
VITE_API_URL=https://your-backend.up.railway.app/api
