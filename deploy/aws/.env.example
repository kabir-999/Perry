POSTGRES_DB=web_fuzzer
POSTGRES_USER=web_fuzzer
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Keep this URL-safe, or URL-encode it before putting it in .env.

JWT_SECRET=change-me-to-a-long-random-value
LOG_ENCRYPTION_KEY=change-me-to-a-different-long-random-value
SCAN_PROFILE=lite

# Same-origin deployment can keep this narrow; include your public hostname.
FRONTEND_ORIGINS=["https://your-domain.example"]

GITHUB_TOKEN=
