# Copy to backend/.env for local dev, or set these as Railway service
# variables for deployment. Nothing here is read anywhere except
# app/config.py.

# --- App ---
ENVIRONMENT=production
DEBUG=false
SCAN_PROFILE=lite
# Set SCAN_PROFILE=balanced on a larger instance if you want the browser crawl.

# --- CORS ---
# Must be a JSON array string (pydantic-settings parses List[str] as JSON).
# Set to your Vercel deployment's origin(s), no trailing slash.
FRONTEND_ORIGINS=["https://your-app.vercel.app"]

# --- Database ---
# On Railway, provision a Postgres plugin and reference its DATABASE_URL
# via ${{Postgres.DATABASE_URL}} in the backend service's variables — do
# not hardcode it. The postgres:// scheme Railway provides is normalized
# automatically in app/config.py.
DATABASE_URL=postgresql+asyncpg://web_fuzzer:web_fuzzer@localhost:5432/web_fuzzer

# --- Authentication (required — change for any non-local deployment) ---
JWT_SECRET=change-me-to-a-long-random-value
LOG_ENCRYPTION_KEY=change-me-to-a-different-long-random-value

GITHUB_TOKEN=
# Optional: set this to enable the richer Groq-backed analysis summary.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=20
